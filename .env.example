# 复制为 .env 后按本机情况修改；所有凭据都不允许硬编码进代码
# 服务与认证（生产环境务必用强随机值）
JINGNI_API_KEY=
JINGNI_API_HOST=127.0.0.1
JINGNI_API_PORT=8000
JINGNI_LOG_LEVEL=INFO

# XtQuant / MiniQMT（路径按本机环境替换）
JINGNI_QMT_PATH=<QMT_USERDATA_DIR>
JINGNI_QMT_ACCOUNT=
# 交易实例 session_id；留空时按账户生成稳定整数（同一账户重启复用）
JINGNI_QMT_SESSION_ID=
# SDK 缺失函数兼容层（26 项缺口中的可派生项）；默认开启
JINGNI_XT_COMPAT=1
# 撤单终态对账窗口/轮询间隔（秒）
JINGNI_XT_CANCEL_RECONCILE_TIMEOUT=5
JINGNI_XT_CANCEL_POLL_INTERVAL=0.2
# 行情 WebSocket 推送默认关闭（未做实盘验证）；确需联调时再打开
JINGNI_WS_MARKET_DATA=0

# GM（掘金量化）；没有 Token 时保持 ENABLED=0
JINGNI_GM_ENABLED=0
JINGNI_GM_TOKEN=
JINGNI_GM_STRATEGY_ID=
JINGNI_GM_ACCOUNT_ID=
# gmtrade 外部交易 sidecar：3.0.6 只有 cp36-cp310 wheel，需用项目 .venv310 的 Python 3.10
# 不填时默认项目内 .venv310\Scripts\python.exe
JINGNI_GMTRADE_PYTHON=
# 仿真端点：api.myquant.cn:9000；实盘按券商/掘金指引调整
JINGNI_GMTRADE_ENDPOINT=api.myquant.cn:9000
# 撤单终态对账窗口/退避轮询（秒）；晚到终态不应被判失败
JINGNI_GM_CANCEL_RECONCILE_TIMEOUT=5
JINGNI_GM_CANCEL_POLL_INTERVAL=0.2
JINGNI_GM_CANCEL_POLL_MAX_INTERVAL=1.0

# TdxQuant（通达信量化；路径按本机环境替换）
JINGNI_TDX_ENABLED=1
JINGNI_TDX_HOME=<TDX_HOME>
JINGNI_TDX_ACCOUNT=
JINGNI_TDX_ACCOUNT_TYPE=stock
JINGNI_TDX_TIMEOUT=30
JINGNI_TDX_CANCEL_RECONCILE_TIMEOUT=30
JINGNI_TDX_POLL_INTERVAL=1.0
# pending_confirm 等待人工确认的幂等窗口（秒）；默认 30 分钟
JINGNI_TDX_PENDING_IDEMPOTENCY_TTL=21600
# 跨重启幂等 SQLite；默认 data/tdx_idempotency.sqlite3
JINGNI_TDX_IDEMPOTENCY_DB=data/tdx_idempotency.sqlite3
